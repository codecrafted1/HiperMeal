# Copy to .env (never commit .env) and export before running, or set in your host.
# Hugging Face token with "Make calls to Inference Providers" permission.
HF_TOKEN=
# Optional overrides
# GEMMA_MODEL=google/gemma-4-E4B-it
# CORS_ORIGINS=http://localhost:5173
# Set to 1 to return a canned sample meal without calling the model (offline demo / UI testing).
# MOCK_MODE=0
